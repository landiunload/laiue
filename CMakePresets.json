{
  "version": 8,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "LAIUE_BUILD_GRAPHICS": "ON",
        "LAIUE_AGGRESSIVE_INLINING": "ON",
        "LAIUE_EXPECTED_ARCHITECTURE": "x86_64",
        "LAIUE_X86_64_LEVEL": "avx2",
        "LAIUE_X86_64_TUNE": "generic"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 + MSVC",
      "description": "Core and D3D12 graphics engine libraries; запускать из Developer Shell нужной архитектуры",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows x64 + clang-cl",
      "description": "Core and D3D12 graphics engine libraries",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "LAIUE_CLANG_LTO_MODE": "full"
      }
    },
    {
      "name": "windows-msvc-arm64",
      "displayName": "Windows ARM64 + MSVC",
      "description": "Core and D3D12 graphics engine libraries for Windows on ARM; запускать из Developer Shell нужной архитектуры",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64"
      }
    },
    {
      "name": "windows-clang-arm64",
      "displayName": "Windows ARM64 + clang-cl",
      "description": "Core and D3D12 graphics engine libraries for Windows on ARM",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "LAIUE_CLANG_LTO_MODE": "full",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "LAIUE_BUILD_GRAPHICS": "OFF",
        "LAIUE_EXPECTED_ARCHITECTURE": "x86_64",
        "LAIUE_X86_64_LEVEL": "avx2",
        "LAIUE_X86_64_TUNE": "generic"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux glibc x64 + GCC",
      "description": "Portable engine core libraries",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "LAIUE_LINUX_LIBC": "gnu"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux glibc x64 + Clang",
      "description": "Portable engine core libraries",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "LAIUE_LINUX_LIBC": "gnu"
      }
    },
    {
      "name": "linux-gcc-arm64",
      "displayName": "Linux glibc ARM64 + GCC",
      "description": "Portable engine core libraries",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64",
        "LAIUE_LINUX_LIBC": "gnu"
      }
    },
    {
      "name": "linux-clang-arm64",
      "displayName": "Linux glibc ARM64 + Clang",
      "description": "Portable engine core libraries",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64",
        "LAIUE_LINUX_LIBC": "gnu"
      }
    },
    {
      "name": "linux-gcc-asan",
      "displayName": "Linux glibc x64 + GCC + ASan/UBSan",
      "description": "Sanitized portable engine core",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
        "LAIUE_ENABLE_LTO": "OFF",
        "LAIUE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-musl",
      "displayName": "Linux musl x64 + GCC",
      "description": "Portable engine core libraries",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "LAIUE_LINUX_LIBC": "musl"
      }
    },
    {
      "name": "linux-vulkan-offscreen",
      "displayName": "Linux x64 Vulkan offscreen renderer",
      "description": "Mesher and Vulkan renderer without a window; needs a Vulkan driver to test",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "LAIUE_BUILD_GRAPHICS": "ON",
        "LAIUE_LINUX_LIBC": "gnu",
        "LAIUE_RENDER_BACKEND": "VULKAN"
      }
    },
    {
      "name": "linux-external-port-smoke",
      "displayName": "Linux x64 external core adapter smoke",
      "description": "Compile-tests the static external-platform seam",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "LAIUE_ENABLE_SDK_INSTALL": "OFF",
        "LAIUE_EXTERNAL_PLATFORM_FILE": "${sourceDir}/tests/external_port/adapter.cmake",
        "LAIUE_MODULE_LIBRARY_TYPE": "STATIC",
        "LAIUE_NATIVE_MOD_MODE": "OFF",
        "LAIUE_PLATFORM_BACKEND": "EXTERNAL"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_DEFAULT_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "LAIUE_BUILD_GRAPHICS": "OFF",
        "LAIUE_X86_64_TUNE": "generic"
      }
    },
    {
      "name": "macos-clang-arm64",
      "displayName": "macOS ARM64 + AppleClang",
      "description": "Portable engine core libraries",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64"
      }
    },
    {
      "name": "macos-clang-x86_64",
      "displayName": "macOS x86_64 + AppleClang",
      "description": "Portable engine core libraries",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "LAIUE_EXPECTED_ARCHITECTURE": "x86_64",
        "LAIUE_X86_64_LEVEL": "avx2"
      }
    },
    {
      "name": "android-arm64-core",
      "displayName": "Android ARM64 core + NDK Clang",
      "description": "Static core plus final link smoke; not an APK or graphics client",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{ANDROID_NDK_HOME}",
        "rhs": ""
      },
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_ALLOW_UNDEFINED_SYMBOLS": "OFF",
        "ANDROID_PLATFORM": "android-28",
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "LAIUE_BUILD_GRAPHICS": "OFF",
        "LAIUE_ENABLE_SDK_INSTALL": "OFF",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64",
        "LAIUE_EXTERNAL_PLATFORM_FILE": "${sourceDir}/cmake/platform/MobileCoreAdapter.cmake",
        "LAIUE_MODULE_LIBRARY_TYPE": "STATIC",
        "LAIUE_NATIVE_MOD_MODE": "OFF",
        "LAIUE_PLATFORM_BACKEND": "EXTERNAL",
        "LAIUE_X86_64_TUNE": "generic"
      }
    },
    {
      "name": "android-arm64-core-closure",
      "displayName": "Android ARM64 complete static-link closure",
      "description": "Debug/no-LTO whole-archive link; catches unresolved symbols hidden by optimization",
      "inherits": "android-arm64-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LAIUE_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "ios-arm64-core",
      "displayName": "iOS ARM64 static core + AppleClang",
      "description": "Static core plus unsigned link smoke; not a product app or Metal client",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "LAIUE_BUILD_GRAPHICS": "OFF",
        "LAIUE_ENABLE_SDK_INSTALL": "OFF",
        "LAIUE_EXPECTED_ARCHITECTURE": "arm64",
        "LAIUE_EXTERNAL_PLATFORM_FILE": "${sourceDir}/cmake/platform/MobileCoreAdapter.cmake",
        "LAIUE_MODULE_LIBRARY_TYPE": "STATIC",
        "LAIUE_NATIVE_MOD_MODE": "OFF",
        "LAIUE_PLATFORM_BACKEND": "EXTERNAL",
        "LAIUE_X86_64_TUNE": "generic"
      }
    }
  ],
